APP_NAME=GitHub Code Intelligence
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=replace_with_secure_random_value
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8501

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/github_intelligence

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/github/oauth/callback
GITHUB_TOKEN_ENCRYPTION_KEY=

GROQ_API_KEY=
GROQ_MODEL=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_SOURCE_FILE_BYTES=500000
MAX_REVIEW_INPUT_TOKENS=20000

LOG_LEVEL=INFO

# Used only by docker compose
POSTGRES_USER=gci
POSTGRES_PASSWORD=replace_with_secure_random_value
POSTGRES_DB=github_intelligence
# EVALUATION_DATA_DIR=   (docker compose sets this; locally it defaults to ./evaluation_data)
